{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://abc.pe/specs/schemas/comprobante-pago.schema.json",
  "title": "ComprobantePago",
  "description": "Agregado raíz del dominio (estado interno ya calculado, antes de serializar a XML UBL 2.1 Perú). Distinto del DTO de la API: aquí existen correlativo, tributos y totales, que la API nunca recibe. Cada propiedad indica su fila de docs/04_MATRIZ_TRAZABILIDAD.md en x-matriz.",
  "type": "object",
  "required": ["id", "tipo", "serie", "correlativo", "fechaEmision", "tipoOperacion", "moneda", "formaPago", "emisor", "cliente", "detalles", "tributos", "totales", "estado"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "tipo": { "enum": ["01", "03", "07", "08"], "x-catalogo": "01", "x-matriz": "T07" },
    "serie": { "type": "string", "pattern": "^[FB][A-Z0-9]{3}$", "x-matriz": "T03", "x-regla": "RN-03" },
    "correlativo": { "type": "integer", "minimum": 1, "maximum": 99999999, "x-matriz": "T03", "x-regla": "RN-04" },
    "fechaEmision": { "type": "string", "format": "date", "x-matriz": "T04", "x-regla": "RN-05" },
    "horaEmision": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d$", "x-matriz": "T05" },
    "fechaVencimiento": { "type": ["string", "null"], "format": "date", "x-matriz": "T06" },
    "tipoOperacion": { "type": "string", "pattern": "^\\d{4}$", "x-catalogo": "51", "x-matriz": "T08" },
    "moneda": { "enum": ["PEN", "USD"], "x-catalogo": "02", "x-matriz": "T10" },
    "tipoCambio": { "type": ["number", "null"], "exclusiveMinimum": 0, "x-regla": "RN-09" },
    "formaPago": { "$ref": "#/$defs/FormaPago" },
    "emisor": { "$ref": "#/$defs/Emisor" },
    "cliente": { "$ref": "#/$defs/Cliente" },
    "detalles": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Detalle" } },
    "descuentosGlobales": { "type": "array", "items": { "$ref": "#/$defs/CargoDescuento" } },
    "tributos": { "type": "array", "items": { "$ref": "#/$defs/Tributo" }, "description": "Resumen por código Cat. 05 (/Invoice/cac:TaxTotal)", "x-matriz": "X09" },
    "totales": { "$ref": "#/$defs/Totales" },
    "leyendas": { "type": "array", "items": { "type": "object", "required": ["codigo", "texto"], "properties": { "codigo": { "type": "string", "pattern": "^\\d{4}$", "x-catalogo": "52" }, "texto": { "type": "string", "maxLength": 200 } } }, "x-matriz": "T09" },
    "documentoReferencia": { "type": ["object", "null"], "description": "Solo notas 07/08", "properties": { "tipo": { "enum": ["01", "03"] }, "numero": { "type": "string", "pattern": "^[FB][A-Z0-9]{3}-\\d{1,8}$" }, "motivo": { "type": "string", "pattern": "^\\d{2}$", "x-catalogo": "09|10" }, "sustento": { "type": "string", "maxLength": 250 } } },
    "estado": { "enum": ["BORRADOR", "VALIDADO", "FIRMADO", "PENDIENTE_ENVIO", "ENVIADO", "ACEPTADO", "ACEPTADO_CON_OBS", "RECHAZADO", "ANULADO"] },
    "hashCpe": { "type": ["string", "null"], "x-matriz": "T12" },
    "respuestaSunat": { "$ref": "#/$defs/RespuestaSunat" }
  },
  "allOf": [
    { "if": { "properties": { "tipo": { "const": "01" } } }, "then": { "properties": { "serie": { "pattern": "^F" }, "cliente": { "properties": { "tipoDoc": { "enum": ["6", "0"] } } } } }, "x-regla": ["RN-03", "RN-06"] },
    { "if": { "properties": { "tipo": { "const": "03" } } }, "then": { "properties": { "serie": { "pattern": "^B" } } }, "x-regla": "RN-03" },
    { "if": { "properties": { "moneda": { "const": "USD" } } }, "then": { "required": ["tipoCambio"], "properties": { "tipoCambio": { "type": "number" } } }, "x-regla": "RN-09" },
    { "if": { "properties": { "formaPago": { "properties": { "tipo": { "const": "Credito" } } } } }, "then": { "required": ["fechaVencimiento"], "properties": { "fechaVencimiento": { "type": "string" } } }, "x-regla": "RN-10" },
    { "if": { "properties": { "tipo": { "enum": ["07", "08"] } } }, "then": { "required": ["documentoReferencia"], "properties": { "documentoReferencia": { "type": "object", "required": ["tipo", "numero", "motivo", "sustento"] } } } }
  ],
  "$defs": {
    "Importe": { "type": "number", "minimum": 0, "maximum": 999999999999.99, "x-formato": "n(12,2)" },
    "Decimal10": { "type": "number", "minimum": 0, "maximum": 999999999999.9999999999, "x-formato": "n(12,10)" },
    "Ruc": { "type": "string", "pattern": "^(10|15|16|17|20)\\d{9}$", "x-regla": "RN-01 (incluye dígito verificador módulo 11)" },
    "Emisor": {
      "type": "object",
      "required": ["ruc", "razonSocial", "ubigeo", "direccion", "codigoEstablecimiento"],
      "properties": {
        "ruc": { "$ref": "#/$defs/Ruc", "x-matriz": "E01" },
        "nombreComercial": { "type": "string", "maxLength": 1500, "x-matriz": "E02" },
        "razonSocial": { "type": "string", "maxLength": 1500, "x-matriz": "E03" },
        "codigoEstablecimiento": { "type": "string", "pattern": "^\\d{4}$", "default": "0000", "x-matriz": "E04" },
        "ubigeo": { "type": "string", "pattern": "^\\d{6}$", "x-matriz": "E05" },
        "direccion": { "type": "string", "maxLength": 200, "x-matriz": "E05" }
      }
    },
    "Cliente": {
      "type": "object",
      "required": ["tipoDoc", "numeroDoc", "razonSocial"],
      "properties": {
        "tipoDoc": { "enum": ["0", "1", "4", "6", "7", "A", "-"], "x-catalogo": "06", "x-matriz": "R01" },
        "numeroDoc": { "type": "string", "maxLength": 15, "x-matriz": "R01", "x-regla": "RN-02" },
        "razonSocial": { "type": "string", "maxLength": 1500, "x-matriz": "R02" },
        "direccion": { "type": ["string", "null"], "maxLength": 200 }
      },
      "allOf": [
        { "if": { "properties": { "tipoDoc": { "const": "6" } } }, "then": { "properties": { "numeroDoc": { "$ref": "#/$defs/Ruc" } } } },
        { "if": { "properties": { "tipoDoc": { "const": "1" } } }, "then": { "properties": { "numeroDoc": { "pattern": "^\\d{8}$" } } } }
      ]
    },
    "FormaPago": {
      "type": "object",
      "required": ["tipo"],
      "x-matriz": "T14",
      "properties": {
        "tipo": { "enum": ["Contado", "Credito"] },
        "montoPendiente": { "$ref": "#/$defs/Importe" },
        "cuotas": { "type": "array", "items": { "type": "object", "required": ["numero", "monto", "fechaVencimiento"], "properties": { "numero": { "type": "string", "pattern": "^Cuota\\d{3}$" }, "monto": { "$ref": "#/$defs/Importe" }, "fechaVencimiento": { "type": "string", "format": "date" } } } }
      },
      "if": { "properties": { "tipo": { "const": "Credito" } } },
      "then": { "required": ["montoPendiente", "cuotas"], "properties": { "cuotas": { "minItems": 1 } } }
    },
    "Detalle": {
      "type": "object",
      "required": ["linea", "codigoProducto", "descripcion", "unidad", "cantidad", "valorUnitario", "precioUnitario", "tipoPrecio", "afectacionIgv", "valorVenta", "tributos"],
      "properties": {
        "linea": { "type": "integer", "minimum": 1, "maximum": 999, "x-matriz": "L01" },
        "cantidad": { "allOf": [{ "$ref": "#/$defs/Decimal10" }], "exclusiveMinimum": 0, "x-matriz": "L02" },
        "unidad": { "type": "string", "pattern": "^[A-Z0-9]{1,3}$", "x-catalogo": "03", "x-matriz": "L03" },
        "descripcion": { "type": "string", "minLength": 1, "maxLength": 500, "x-matriz": "L04" },
        "codigoProducto": { "type": "string", "maxLength": 30, "x-matriz": "L05" },
        "codigoSunat": { "type": ["string", "null"], "pattern": "^\\d{8}$", "x-catalogo": "25", "x-matriz": "L06" },
        "valorUnitario": { "$ref": "#/$defs/Decimal10", "x-matriz": "L07" },
        "precioUnitario": { "$ref": "#/$defs/Decimal10", "x-matriz": "L08" },
        "tipoPrecio": { "enum": ["01", "02"], "x-catalogo": "16", "x-matriz": "L08" },
        "afectacionIgv": { "type": "string", "pattern": "^(1[0-7]|2[01]|3[0-6]|40)$", "x-catalogo": "07", "x-matriz": "X02" },
        "descuentos": { "type": "array", "items": { "$ref": "#/$defs/CargoDescuento" } },
        "valorVenta": { "$ref": "#/$defs/Importe", "x-matriz": "L09" },
        "tributos": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Tributo" } }
      }
    },
    "Tributo": {
      "type": "object",
      "required": ["codigo", "nombre", "codigoInternacional", "base", "monto"],
      "properties": {
        "codigo": { "enum": ["1000", "1016", "2000", "7152", "9995", "9996", "9997", "9998", "9999"], "x-catalogo": "05", "x-matriz": "X01" },
        "nombre": { "enum": ["IGV", "IVAP", "ISC", "ICBPER", "EXP", "GRA", "EXO", "INA", "OTROS"] },
        "codigoInternacional": { "enum": ["VAT", "EXC", "OTH", "FRE"] },
        "base": { "$ref": "#/$defs/Importe", "x-matriz": "X07" },
        "tasa": { "type": ["number", "null"], "x-matriz": ["X03", "X05"] },
        "montoPorUnidad": { "type": ["number", "null"], "description": "ICBPER (cbc:PerUnitAmount)", "x-matriz": "X06" },
        "cantidadUnidades": { "type": ["number", "null"], "description": "ICBPER (cbc:BaseUnitMeasure)", "x-matriz": "X06" },
        "sistemaIsc": { "enum": ["01", "02", "03", null], "x-catalogo": "08", "x-matriz": "X04" },
        "monto": { "$ref": "#/$defs/Importe", "x-matriz": "X08" }
      },
      "allOf": [
        { "if": { "properties": { "codigo": { "const": "2000" } } }, "then": { "required": ["sistemaIsc"], "properties": { "sistemaIsc": { "enum": ["01", "02", "03"] } } }, "else": { "properties": { "sistemaIsc": { "const": null } } }, "x-regla": "RN-07 (Catálogo 08 solo en ISC)" },
        { "if": { "properties": { "codigo": { "const": "7152" } } }, "then": { "required": ["montoPorUnidad", "cantidadUnidades"] } }
      ]
    },
    "CargoDescuento": {
      "type": "object",
      "required": ["esCargo", "codigo", "monto"],
      "properties": {
        "esCargo": { "type": "boolean", "description": "cbc:ChargeIndicator" },
        "codigo": { "type": "string", "pattern": "^\\d{2}$", "x-catalogo": "53" },
        "factor": { "type": ["number", "null"] },
        "monto": { "$ref": "#/$defs/Importe" },
        "base": { "$ref": "#/$defs/Importe" }
      }
    },
    "Totales": {
      "type": "object",
      "required": ["valorVenta", "totalTributos", "precioVenta", "importeTotal"],
      "x-regla": "RN-08",
      "properties": {
        "valorVenta": { "$ref": "#/$defs/Importe", "x-matriz": "M01" },
        "totalTributos": { "$ref": "#/$defs/Importe", "x-matriz": "X09" },
        "precioVenta": { "$ref": "#/$defs/Importe", "x-matriz": "M02" },
        "descuentosNoAfectanBase": { "$ref": "#/$defs/Importe", "x-matriz": "M03" },
        "cargos": { "$ref": "#/$defs/Importe", "x-matriz": "M04" },
        "anticipos": { "$ref": "#/$defs/Importe", "x-matriz": "M05" },
        "importeTotal": { "$ref": "#/$defs/Importe", "x-matriz": "M06" }
      }
    },
    "RespuestaSunat": {
      "type": ["object", "null"],
      "properties": {
        "codigo": { "type": "string", "pattern": "^\\d{1,4}$" },
        "descripcion": { "type": "string" },
        "observaciones": { "type": "array", "items": { "type": "string" } },
        "fecha": { "type": "string", "format": "date-time" }
      }
    }
  }
}
